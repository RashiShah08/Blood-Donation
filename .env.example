# Copy this file to .env and fill in real values. Never commit .env.

# --- Core ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace_with_a_long_random_string
# 1 for local development (auto-reload, temporary secret key allowed). Never 1 in production.
FLASK_DEBUG=1
# Set to 1 when the site is served over HTTPS.
SESSION_COOKIE_SECURE=0

# --- Database (PostgreSQL, required) ------------------------------------
# `docker compose up -d` starts a local PostgreSQL that matches these URLs.
# Use 127.0.0.1, not localhost: on Windows, localhost tries IPv6 first and every connection waits ~2 s.
DATABASE_URL=postgresql://bloodconnect:bloodconnect@127.0.0.1:5432/bloodconnect
# Used only by the test suite. It is emptied on every test run: never point it at real data.
TEST_DATABASE_URL=postgresql://bloodconnect:bloodconnect@127.0.0.1:5432/bloodconnect_test

# --- Email alerts (optional) -------------------------------------------
# Without email settings, alerts are written to the log instead of sent (demo mode).
# Option 1, Brevo over HTTPS (works on hosts that block SMTP, such as Render's free tier).
# MAIL_FROM_EMAIL must be a sender you verified in Brevo.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
# Option 2, SMTP. For Gmail, use an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_ADDRESS=
EMAIL_PASSWORD=
MAIL_FROM_NAME=BloodConnect
# Public URL used in email links, e.g. https://bloodconnect.example.org
PUBLIC_BASE_URL=

# --- Directions (optional) ---------------------------------------------
# OpenRouteService key for road routes. Without it, directions use a straight line.
ORS_API_KEY=

# --- Hosting -------------------------------------------------------------
# Number of reverse proxies in front of the app: 1 on Render, 0 when run directly.
TRUST_PROXY_HOPS=0

# --- Behaviour ----------------------------------------------------------
# 1 = hospitals must be verified (flask --app app verify-hospital EMAIL) before alerting donors.
REQUIRE_HOSPITAL_VERIFICATION=0
# How far away (km) requests are shown to donors.
DONOR_REQUEST_RADIUS_KM=50
# Rate limit storage. memory:// is fine for one process; use redis://... for several.
RATELIMIT_STORAGE_URI=memory://
LOG_LEVEL=INFO
